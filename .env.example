# PostgreSQL Database Configuration
# Copy this to your .env file and update the values accordingly

# Discord Bot Configuration (REQUIRED)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_development_guild_id

# Discord OAuth2 Configuration (REQUIRED for Dashboard)
DISCORD_CLIENT_SECRET=your_discord_client_secret

# API Server Configuration
API_PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Environment
NODE_ENV=development

# Option 1: Use individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bottrapper
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Option 2: Use a complete connection string (this takes precedence over individual params)
# DATABASE_URL=postgresql://username:password@localhost:5432/bottrapper

# For production with SSL (e.g., Heroku, Railway, etc.)
# DATABASE_URL=postgresql://username:password@hostname:5432/database?sslmode=require

# Logging Configuration
LOG_LEVEL=info

# Sentry Error Reporting (Optional)
# SENTRY_DSN=https://your_sentry_dsn_here

# Legacy SQLite path (only needed for migration)
SQLITE_DATABASE_PATH=./data/bot.db
